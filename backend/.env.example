# Server
NODE_ENV=production
PORT=5000
FRONTEND_URL=http://YOUR_VPS_IP

# Database (PostgreSQL)
# In docker-compose, host is "postgres" (service name)
DATABASE_URL=postgresql://rajmobile:YOUR_STRONG_PASSWORD@postgres:5432/rajmobile

# Redis
REDIS_URL=redis://:YOUR_REDIS_PASSWORD@redis:6379

# JWT — generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=your-access-secret-key-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-key-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Resend (Email — optional)
RESEND_API_KEY=
FROM_EMAIL=noreply@rajmobileandelectrics.com

# Stripe (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# eSewa — use live URL in production
ESEWA_MERCHANT_CODE=
ESEWA_SECRET_KEY=
ESEWA_BASE_URL=https://epay.esewa.com.np

# Khalti — use live URL in production
KHALTI_SECRET_KEY=
KHALTI_BASE_URL=https://khalti.com

# App
APP_NAME=Raj Mobile & Electrics
DEFAULT_CURRENCY=NPR
TAX_RATE=13
DELIVERY_FEE=100
FREE_DELIVERY_THRESHOLD=5000
ADMIN_EMAIL=admin@rajmobileandelectrics.com
ADMIN_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
