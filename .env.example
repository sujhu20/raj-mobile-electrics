# ============================================================
# Raj Mobile & Electrics — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# For Coolify deployment, set these in Coolify's
# "Environment Variables" panel — do NOT create a .env file
# on the server manually.
# ============================================================

# ── Server ──────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# The public URL where the frontend is accessible.
# Without a domain, use your VPS IP:
#   FRONTEND_URL=http://123.45.67.89
FRONTEND_URL=http://YOUR_VPS_IP

# ── Database (PostgreSQL) ───────────────────────────────────
# For docker-compose: postgres host is "postgres" (service name)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://rajmobile:YOUR_STRONG_PASSWORD@postgres:5432/rajmobile

# Docker Compose postgres service credentials (must match DATABASE_URL)
POSTGRES_DB=rajmobile
POSTGRES_USER=rajmobile
POSTGRES_PASSWORD=YOUR_STRONG_PASSWORD

# ── Redis ───────────────────────────────────────────────────
# For docker-compose: redis host is "redis" (service name)
# Leave REDIS_PASSWORD empty to disable redis auth (not recommended for production)
REDIS_URL=redis://:YOUR_REDIS_PASSWORD@redis:6379
REDIS_PASSWORD=YOUR_REDIS_PASSWORD

# ── JWT Secrets ─────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=GENERATE_A_RANDOM_64_CHAR_SECRET_HERE
JWT_REFRESH_SECRET=GENERATE_A_DIFFERENT_RANDOM_64_CHAR_SECRET_HERE
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── Cloudinary (Image Uploads) ──────────────────────────────
# Get these from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Google OAuth (Optional) ─────────────────────────────────
# Get from https://console.cloud.google.com
# Leave blank to disable Google login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email — Resend (Optional) ───────────────────────────────
# Get from https://resend.com
# Leave blank to disable transactional emails
RESEND_API_KEY=
FROM_EMAIL=noreply@rajmobileandelectrics.com

# ── Payment — Stripe (Optional) ─────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Payment — eSewa ─────────────────────────────────────────
ESEWA_MERCHANT_CODE=
ESEWA_SECRET_KEY=
# Use live URL in production: https://epay.esewa.com.np
ESEWA_BASE_URL=https://epay.esewa.com.np

# ── Payment — Khalti ────────────────────────────────────────
KHALTI_SECRET_KEY=
# Use live URL in production: https://khalti.com
KHALTI_BASE_URL=https://khalti.com

# ── App Configuration ───────────────────────────────────────
APP_NAME=Raj Mobile & Electrics
DEFAULT_CURRENCY=NPR
TAX_RATE=13
DELIVERY_FEE=100
FREE_DELIVERY_THRESHOLD=5000

# Initial admin account (used by prisma seed)
ADMIN_EMAIL=admin@rajmobileandelectrics.com
ADMIN_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# ── Frontend API URL ────────────────────────────────────────
# This is passed as a build argument to the frontend Docker image.
# Must point to your VPS backend — no trailing slash.
# Without a domain: http://YOUR_VPS_IP:5000/api
VITE_API_URL=http://YOUR_VPS_IP:5000/api
